@model CIM.CRM.Models.Oportunidad
@{
    ViewData["Title"] = Model.Nombre;
    ViewData["Titulo"] = Model.Nombre;
    ViewData["Subtitulo"] = "Ficha de la oportunidad";
    var cultura = new System.Globalization.CultureInfo("es-MX");
}

@section Styles {
    <link rel="stylesheet" href="~/css/oportunidades.css" asp-append-version="true" />
}

<div class="cim-card">
    <div class="cim-card-encabezado">
        <h2>Datos generales</h2>
        <div class="d-flex gap-2 align-items-center">
            @if (Model.FechaCierreReal == null)
            {
                <a class="btn-cerrar" asp-action="Cerrar" asp-route-id="@Model.OportunidadId">Cerrar venta</a>
            }
            <a class="btn-mini" asp-action="Edit" asp-route-id="@Model.OportunidadId">Editar</a>
            <a class="liga" asp-action="Index">Volver a la lista</a>
        </div>
    </div>

    <div class="cim-card-cuerpo">
        <div class="ficha">
            <div class="campo">
                <span class="etiqueta">Etapa</span>
                <span class="valor">
                    <span class="etiqueta-etapa et-@(Model.Etapa.ToLower().Replace("ó", "o"))">@Model.Etapa</span>
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.Importe)</span>
                <span class="valor importe @(Model.Importe == null ? "vacio" : "")">
                    @(Model.Importe == null ? "-" : Model.Importe.Value.ToString("C0", cultura))
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.Probabilidad)</span>
                <span class="valor @(Model.Probabilidad == null ? "vacio" : "")">
                    @(Model.Probabilidad == null ? "-" : Model.Probabilidad.Value.ToString("0") + " %")
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.EmpresaId)</span>
                <span class="valor @(Model.Empresa == null ? "vacio" : "")">
                    @if (Model.Empresa != null)
                    {
                        <a asp-controller="Empresas" asp-action="Details"
                           asp-route-id="@Model.EmpresaId">@Model.Empresa.Nombre</a>
                    }
                    else
                    {
                        <text>-</text>
                    }
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.ContactoId)</span>
                <span class="valor @(Model.Contacto == null ? "vacio" : "")">
                    @if (Model.Contacto != null)
                    {
                        <a asp-controller="Contactos" asp-action="Details"
                           asp-route-id="@Model.ContactoId">@($"{Model.Contacto.Nombre} {Model.Contacto.Apellidos}".Trim())</a>
                    }
                    else
                    {
                        <text>Sin contacto</text>
                    }
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.FechaEstimadaCierre)</span>
                <span class="valor @(Model.FechaEstimadaCierre == null ? "vacio" : "")">
                    @(Model.FechaEstimadaCierre == null
                        ? "-"
                        : Model.FechaEstimadaCierre.Value.ToString("dd/MM/yyyy"))
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.UsuarioId)</span>
                <span class="valor @(Model.Usuario == null ? "vacio" : "")">
                    @(Model.Usuario == null
                        ? "Sin asignar"
                        : $"{Model.Usuario.Nombre} {Model.Usuario.Apellidos}".Trim())
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.FechaCreacion)</span>
                <span class="valor">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <div class="ficha" style="margin-top:1.5rem">
                <div class="campo" style="grid-column:1/-1">
                    <span class="etiqueta">@Html.DisplayNameFor(m => m.Descripcion)</span>
                    <span class="valor">@Model.Descripcion</span>
                </div>
            </div>
        }

        @if (Model.FechaCierreReal != null)
        {
            <div class="bloque-cierre">
                <div class="ficha">
                    <div class="campo">
                        <span class="etiqueta">@Html.DisplayNameFor(m => m.FechaCierreReal)</span>
                        <span class="valor">@Model.FechaCierreReal.Value.ToString("dd/MM/yyyy")</span>
                    </div>

                    <div class="campo">
                        <span class="etiqueta">@Html.DisplayNameFor(m => m.MotivoPerdida)</span>
                        <span class="valor @(string.IsNullOrWhiteSpace(Model.MotivoPerdida) ? "vacio" : "")">
                            @(string.IsNullOrWhiteSpace(Model.MotivoPerdida) ? "-" : Model.MotivoPerdida)
                        </span>
                    </div>
                </div>
            </div>
        }

        <div class="bloque-cotizaciones">
            <div class="titulo-bloque">
                <h3>Cotizaciones</h3>
                <a class="btn-mini" asp-controller="Cotizaciones" asp-action="Create"
                   asp-route-oportunidadId="@Model.OportunidadId">Nueva cotización</a>
            </div>

            @if (!Model.Cotizaciones.Any())
            {
                <div class="cim-vacio">
                    Esta oportunidad todavía no tiene cotizaciones.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="tabla-cim">
                        <thead>
                            <tr>
                                <th>Folio</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th class="monto">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var cotizacion in Model.Cotizaciones.OrderByDescending(c => c.Fecha))
                        {
                            var claseEstado = "es-" + cotizacion.Estado.ToLower()
                                .Replace("ó", "o").Replace(" ", "-");
                            <tr>
                                <td>
                                    <a class="principal" asp-controller="Cotizaciones" asp-action="Details"
                                       asp-route-id="@cotizacion.CotizacionId">@cotizacion.Folio</a>
                                </td>
                                <td>@cotizacion.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="etiqueta-estado @claseEstado">@cotizacion.Estado</span>
                                </td>
                                <td class="monto">@cotizacion.Total.ToString("C2", cultura)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="pie-conteo">@Model.Cotizaciones.Count() cotización(es).</div>
            }
        </div>
    </div>
</div>
