@model CIM.CRM.Models.Oportunidad
@{
    ViewData["Title"] = "Nueva oportunidad";
    ViewData["Titulo"] = "Nueva oportunidad";
    ViewData["Subtitulo"] = "Registra una venta que está en trámite";
}

@section Styles {
    <link rel="stylesheet" href="~/css/oportunidades.css" asp-append-version="true" />
}

<div class="cim-card">
    <div class="cim-card-encabezado">
        <h2>Datos de la oportunidad</h2>
        <a class="liga" asp-action="Index">Volver a la lista</a>
    </div>

    <div class="cim-card-cuerpo">
        <form asp-action="Create" method="post" class="opo-form">
            <div asp-validation-summary="ModelOnly" class="cim-aviso cim-aviso-error"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autofocus
                           placeholder="Cámara de refrigeración" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EmpresaId" class="form-label"></label>
                    <select asp-for="EmpresaId" id="EmpresaId" class="form-select"
                            asp-items="@(ViewData["Empresas"] as SelectList)">
                        <option value="">— Escoja la empresa —</option>
                    </select>
                    <span asp-validation-for="EmpresaId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ContactoId" class="form-label"></label>
                    <select asp-for="ContactoId" id="ContactoId" class="form-select">
                        <option value="">— Sin contacto —</option>
                    </select>
                    <span class="nota-campo">Salen los contactos de la empresa escogida.</span>
                    <span asp-validation-for="ContactoId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <input asp-for="Descripcion" class="form-control"
                           placeholder="Qué se le va a vender" />
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Importe" class="form-label"></label>
                    <input asp-for="Importe" class="form-control" type="number" step="0.01" min="0"
                           placeholder="0.00" />
                    <span asp-validation-for="Importe" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Etapa" class="form-label"></label>
                    <select asp-for="Etapa" class="form-select"
                            asp-items="@(ViewData["Etapas"] as SelectList)">
                    </select>
                    <span asp-validation-for="Etapa" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Probabilidad" class="form-label"></label>
                    <input asp-for="Probabilidad" class="form-control" type="number" step="1" min="0" max="100"
                           placeholder="0 a 100" />
                    <span asp-validation-for="Probabilidad" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaEstimadaCierre" class="form-label"></label>
                    <input asp-for="FechaEstimadaCierre" class="form-control" type="date" />
                    <span asp-validation-for="FechaEstimadaCierre" class="text-danger small"></span>
                </div>

                @if ((bool?)ViewData["PuedeAsignar"] == true)
                {
                    <div class="col-md-4">
                        <label asp-for="UsuarioId" class="form-label"></label>
                        <select asp-for="UsuarioId" class="form-select"
                                asp-items="@(ViewData["Ejecutivos"] as SelectList)">
                            <option value="">— Sin asignar —</option>
                        </select>
                        <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                    </div>
                }
            </div>

            <div class="pie-form">
                <button type="submit" class="cim-btn">Guardar oportunidad</button>
                <a asp-action="Index" class="liga-cancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script id="datos-contactos" type="application/json">
        @Html.Raw(ViewData["ContactosJson"] ?? "[]")
    </script>

    <script>
        (function () {
            var contactos = JSON.parse(document.getElementById("datos-contactos").textContent);
            var comboEmpresa = document.getElementById("EmpresaId");
            var comboContacto = document.getElementById("ContactoId");

            function llenarContactos() {
                var empresa = comboEmpresa.value;
                var elegido = comboContacto.value;

                comboContacto.innerHTML = '<option value="">— Sin contacto —</option>';

                contactos
                    .filter(function (c) { return String(c.empresaId) === String(empresa); })
                    .forEach(function (c) {
                        var opcion = document.createElement("option");
                        opcion.value = c.contactoId;
                        opcion.textContent = c.nombre;
                        if (String(c.contactoId) === String(elegido)) {
                            opcion.selected = true;
                        }
                        comboContacto.appendChild(opcion);
                    });
            }

            comboEmpresa.addEventListener("change", llenarContactos);
            llenarContactos();
        })();
    </script>
}