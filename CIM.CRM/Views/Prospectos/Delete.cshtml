@model CIM.CRM.Models.Prospecto
@{
    ViewData["Title"] = "Eliminar prospecto";
    ViewData["Titulo"] = Model.Nombre;
    ViewData["Subtitulo"] = "Confirmar la eliminación";
}

@section Styles {
    <link rel="stylesheet" href="~/css/prospectos.css" asp-append-version="true" />
}

<div class="cim-card">
    <div class="cim-card-encabezado">
        <h2>¿Eliminar este prospecto?</h2>
        <a class="liga" asp-action="Index">Volver a la lista</a>
    </div>

    <div class="cim-card-cuerpo">
        <div class="aviso-borrar">
            <span class="ico">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1 0 15h16L8 1Zm0 5v4.5h1.2V6H8Zm.6 6.2a.9.9 0 1 0 0 1.8.9.9 0 0 0 0-1.8Z"/></svg>
            </span>
            <div>
                Esta acción no se puede deshacer.
                Si el prospecto tiene actividades u oportunidades ligadas,
                el sistema no lo va a dejar borrar.
                Si nada más dijo que no le interesa, conviene marcarlo como
                <strong>No interesado</strong> en lugar de borrarlo.
            </div>
        </div>

        <div class="ficha">
            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.Nombre)</span>
                <span class="valor">@Model.Nombre</span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.NombreEmpresa)</span>
                <span class="valor @(string.IsNullOrWhiteSpace(Model.NombreEmpresa) ? "vacio" : "")">
                    @(string.IsNullOrWhiteSpace(Model.NombreEmpresa) ? "-" : Model.NombreEmpresa)
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">Estado</span>
                <span class="valor"><span class="etiqueta-estado">@Model.Estado</span></span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.Telefono)</span>
                <span class="valor @(string.IsNullOrWhiteSpace(Model.Telefono) ? "vacio" : "")">
                    @(string.IsNullOrWhiteSpace(Model.Telefono) ? "-" : Model.Telefono)
                </span>
            </div>

            <div class="campo">
                <span class="etiqueta">@Html.DisplayNameFor(m => m.UsuarioId)</span>
                <span class="valor @(Model.Usuario == null ? "vacio" : "")">
                    @(Model.Usuario == null
                        ? "Sin asignar"
                        : $"{Model.Usuario.Nombre} {Model.Usuario.Apellidos}".Trim())
                </span>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="pro-form">
            <input type="hidden" asp-for="ProspectoId" />
            <div class="pie-form">
                <button type="submit" class="btn-peligro">Sí, eliminar</button>
                <a asp-action="Index" class="liga-cancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>