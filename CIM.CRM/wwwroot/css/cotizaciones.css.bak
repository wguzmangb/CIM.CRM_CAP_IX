.cot-buscador {
    display: flex;
    gap: .5rem;
    align-items: center;
}

    .cot-buscador input {
        border: 1px solid var(--cim-border-input);
        border-radius: var(--cim-radius);
        padding: .45rem .85rem;
        font-size: .8125rem;
        min-width: 260px;
    }

        .cot-buscador input:focus {
            outline: 0;
            border-color: var(--cim-primary);
            box-shadow: 0 0 0 3px var(--cim-primary-soft);
        }

    .cot-buscador .liga-limpiar {
        font-size: .8rem;
        color: var(--cim-muted);
        text-decoration: none;
    }

        .cot-buscador .liga-limpiar:hover {
            color: var(--cim-primary);
        }

.tabla-cim {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: .8125rem;
}

    .tabla-cim thead th {
        background: var(--cim-surface-alt);
        color: var(--cim-muted);
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: .75rem 1.5rem;
        border-bottom: 1px solid var(--cim-border);
        white-space: nowrap;
    }

    .tabla-cim tbody td {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--cim-border);
        color: var(--cim-text-soft);
        vertical-align: middle;
    }

    .tabla-cim tbody tr:last-child td {
        border-bottom: 0;
    }

    .tabla-cim tbody tr:hover {
        background: var(--cim-surface-alt);
    }

    .tabla-cim .principal {
        font-weight: 600;
        color: var(--cim-text);
        text-decoration: none;
    }

        .tabla-cim .principal:hover {
            color: var(--cim-primary);
        }

    .tabla-cim .sin-dato {
        color: var(--cim-hint);
    }

    .tabla-cim .monto {
        text-align: right;
        white-space: nowrap;
        font-weight: 600;
        color: var(--cim-text);
    }

    .tabla-cim th.monto {
        font-weight: 700;
        color: var(--cim-muted);
    }

    .tabla-cim .acciones {
        text-align: right;
        white-space: nowrap;
    }

.pie-conteo {
    padding: .85rem 1.5rem;
    font-size: .8rem;
    color: var(--cim-muted);
}

/* El folio y la venta, en la misma celda */
.cot-folio {
    display: block;
    font-weight: 600;
    color: var(--cim-text);
    text-decoration: none;
}

    .cot-folio:hover {
        color: var(--cim-primary);
    }

.cot-venta {
    display: block;
    margin-top: .2rem;
    font-size: .75rem;
    color: var(--cim-muted);
}

/* El estado, cada uno con su color */
.etiqueta-estado {
    display: inline-block;
    padding: .2rem .6rem;
    border-radius: 999px;
    font-size: .7rem;
    font-weight: 700;
    background: var(--cim-surface-alt);
    color: var(--cim-muted);
    border: 1px solid transparent;
    white-space: nowrap;
}

    .etiqueta-estado.es-enviada {
        color: var(--cim-info);
        border-color: var(--cim-info);
    }

    .etiqueta-estado.es-aceptada {
        color: var(--cim-success);
        border-color: var(--cim-success);
    }

    .etiqueta-estado.es-rechazada {
        color: var(--cim-danger);
        border-color: var(--cim-danger);
    }

.btn-mini {
    display: inline-block;
    font-size: .75rem;
    font-weight: 600;
    padding: .3rem .7rem;
    border-radius: var(--cim-radius);
    border: 1px solid var(--cim-border-input);
    background: #fff;
    color: var(--cim-text-soft);
    text-decoration: none;
}

    .btn-mini:hover {
        border-color: var(--cim-primary);
        color: var(--cim-primary);
    }

display: inline-block;
padding: .2rem .6rem;
border-radius: 999px;
font-size: .7rem;
font-weight: 700;
background: var(--cim-surface-alt);
color: var(--cim-muted);
border: 1px solid transparent;
white-space: nowrap;
}

.etiqueta-estado.es-enviada {
    color: var(--cim-info);
    border-color: var(--cim-info);
}

.etiqueta-estado.es-aceptada {
    color: var(--cim-success);
    border-color: var(--cim-success);
}

.etiqueta-estado.es-rechazada {
    color: var(--cim-danger);
    border-color: var(--cim-danger);
}

.btn-mini {
    display: inline-block;
    font-size: .75rem;
    font-weight: 600;
    padding: .3rem .7rem;
    border-radius: var(--cim-radius);
    border: 1px solid var(--cim-border-input);
    background: #fff;
    color: var(--cim-text-soft);
    text-decoration: none;
}

    .btn-mini:hover {
        border-color: var(--cim-primary);
        color: var(--cim-primary);
    }

    .btn-mini.peligro:hover {
        border-color: var(--cim-danger);
        color: var(--cim-danger);
    }

/* ── El formulario ──────────────────────────────── */

.cot-form .form-label {
    font-size: .75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
    color: var(--cim-muted);
    margin-bottom: .4rem;
}

.cot-form .form-control,
.cot-form .form-select {
    border: 1px solid var(--cim-border-input);
    border-radius: var(--cim-radius);
    padding: .6rem .85rem;
    font-size: .875rem;
    color: var(--cim-text);
}

    .cot-form .form-control:focus,
    .cot-form .form-select:focus {
        border-color: var(--cim-primary);
        box-shadow: 0 0 0 3px var(--cim-primary-soft);
    }

.cot-form .pie-form {
    display: flex;
    gap: .75rem;
    align-items: center;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--cim-border);
}

.cot-form .liga-cancelar {
    font-size: .8125rem;
    font-weight: 600;
    color: var(--cim-muted);
    text-decoration: none;
}

    .cot-form .liga-cancelar:hover {
        color: var(--cim-text);
    }

.cot-form .nota-campo {
    display: block;
    margin-top: .35rem;
    font-size: .75rem;
    color: var(--cim-hint);
}

/* ── Los renglones ──────────────────────────────── */

.cot-renglones {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--cim-border);
}

    .cot-renglones .titulo-bloque {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

        .cot-renglones .titulo-bloque h3 {
            margin: 0;
            font-size: .95rem;
            font-weight: 700;
            color: var(--cim-text);
        }

.tabla-renglones {
    width: 100%;
    border-collapse: collapse;
    font-size: .8125rem;
}

    .tabla-renglones thead th {
        background: var(--cim-surface-alt);
        color: var(--cim-muted);
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: .6rem .75rem;
        border-bottom: 1px solid var(--cim-border);
        white-space: nowrap;
        text-align: left;
    }

    .tabla-renglones td {
        padding: .5rem .75rem;
        border-bottom: 1px solid var(--cim-border);
        vertical-align: top;
    }

    .tabla-renglones .col-cantidad,
    .tabla-renglones .col-precio {
        width: 130px;
    }

    .tabla-renglones .col-importe {
        width: 140px;
        text-align: right;
    }

    .tabla-renglones .col-quitar {
        width: 46px;
        text-align: right;
    }

    .tabla-renglones .importe-renglon {
        display: block;
        padding-top: .6rem;
        font-weight: 600;
        color: var(--cim-text);
        text-align: right;
        white-space: nowrap;
    }

    .tabla-renglones .form-control {
        width: 100%;
    }

.btn-quitar {
    margin-top: .35rem;
    border: 1px solid var(--cim-border-input);
    background: #fff;
    color: var(--cim-muted);
    border-radius: var(--cim-radius);
    width: 30px;
    height: 30px;
    line-height: 1;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
}

    .btn-quitar:hover {
        border-color: var(--cim-danger);
        color: var(--cim-danger);
    }

/* ── Los totales ──────────────────────────────── */

.cot-totales {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.25rem;
}

    .cot-totales dl {
        margin: 0;
        min-width: 280px;
    }

    .cot-totales .renglon {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        padding: .45rem 0;
        font-size: .875rem;
        color: var(--cim-text-soft);
    }

        .cot-totales .renglon dt {
            font-weight: 600;
        }

        .cot-totales .renglon dd {
            margin: 0;
            font-weight: 600;
            color: var(--cim-text);
            white-space: nowrap;
        }

        .cot-totales .renglon.total {
            margin-top: .35rem;
            padding-top: .75rem;
            border-top: 1px solid var(--cim-border);
            font-size: 1.05rem;
        }

            .cot-totales .renglon.total dt,
            .cot-totales .renglon.total dd {
                font-weight: 700;
                color: var(--cim-text);
            }


/* ── La ficha ──────────────────────────────── */

.ficha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
}

    .ficha .campo .etiqueta {
        display: block;
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--cim-muted);
        margin-bottom: .3rem;
    }

    .ficha .campo .valor {
        display: block;
        font-size: .9375rem;
        color: var(--cim-text);
    }

        .ficha .campo .valor a {
            color: var(--cim-primary);
            text-decoration: none;
        }

            .ficha .campo .valor a:hover {
                text-decoration: underline;
            }

        .ficha .campo .valor.vacio {
            color: var(--cim-hint);
        }

        .ficha .campo .valor.importe {
            font-size: 1.35rem;
            font-weight: 700;
        }

.bloque-renglones {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--cim-border);
}

    .bloque-renglones h3 {
        margin: 0 0 1rem;
        font-size: .95rem;
        font-weight: 700;
        color: var(--cim-text);
    }

    .bloque-renglones .tabla-cim thead th,
    .bloque-renglones .tabla-cim tbody td {
        padding-left: .75rem;
        padding-right: .75rem;
    }

    .bloque-renglones .tabla-cim tbody td {
        padding-top: .65rem;
        padding-bottom: .65rem;
    }
/* ── El borrado ──────────────────────────────── */

.aviso-borrar {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: rgba(251, 99, 64, .08);
    border-left: 3px solid var(--cim-warning);
    border-radius: var(--cim-radius);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    font-size: .875rem;
    color: var(--cim-text-soft);
}

    .aviso-borrar .ico {
        color: var(--cim-warning);
        flex: 0 0 20px;
    }

.btn-peligro {
    display: inline-block;
    background: var(--cim-grad-danger);
    color: #fff;
    border: 0;
    border-radius: var(--cim-radius);
    padding: .55rem 1.15rem;
    font-size: .8125rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--cim-shadow-icon);
}

    .btn-peligro:hover {
        color: #fff;
        opacity: .92;
    }